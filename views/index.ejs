
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- The title displayed in the browser tab -->
  <title>SkyCast | Weather Forecast</title>

  <!-- Connect this page to our custom CSS file -->
  <link rel="stylesheet" href="/styles.css">

  <!-- Load Bootstrap for additional layout and utility classes -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
  <!-- Main container for the entire weather application -->
  <main class="weather-app">

    <!-- App heading and introduction -->
    <header class="app-header">
      <div class="brand-icon">☁️</div>
      <h1>SkyCast</h1>
      <p>Your daily weather, at a glance.</p>
    </header>

    <!--
      This form sends the city name to the POST /weather route
      in index.js. The server then retrieves the weather data.
    -->
    <form action="/weather" method="POST" class="search-form">
      <label for="city" class="visually-hidden">City name</label>

      <!--
        EJS inserts the previous search into the input.
        The condition prevents an empty value when no city was searched.
      -->
      <input
        type="text"
        id="city"
        name="city"
        placeholder="Enter a city"
        value="<%= searchedCity || '' %>"
        required
      >

      <button type="submit">Search</button>
    </form>

    <!-- Display an error message if the server reports one -->
    <% if (error) { %>
      <div class="error-message" role="alert">
        <%= error %>
      </div>
    <% } %>

    <!-- CURRENT WEATHER: show this section only when weather data exists -->
    <% if (weather && weather.main && weather.weather) { %>
      <section class="current-weather">
        <div class="current-location">
          <h2>
            <%= weather.name %><% if (weather.sys && weather.sys.country) { %>, <%= weather.sys.country %><% } %>
          </h2>
          <p>Current weather</p>
        </div>

        <!-- Display the weather icon returned by OpenWeather -->
        <img
          class="current-icon"
          src="https://openweathermap.org/img/wn/<%= weather.weather[0].icon %>@2x.png"
          alt="<%= weather.weather[0].description %>"
        >

        <!-- Round the temperature to a whole number -->
        <div class="current-temperature">
          <%= Math.round(weather.main.temp) %>°C
        </div>

        <p class="weather-description">
          <%= weather.weather[0].description %>
        </p>

        <!-- Extra details about the current conditions -->
        <div class="weather-details">
          <div class="detail-item">
            <span>Feels like</span>
            <strong><%= Math.round(weather.main.feels_like) %>°C</strong>
          </div>

          <div class="detail-item">
            <span>Humidity</span>
            <strong><%= weather.main.humidity %>%</strong>
          </div>

          <div class="detail-item">
            <span>Wind speed</span>
            <strong><%= weather.wind.speed %> m/s</strong>
          </div>

          <div class="detail-item">
            <span>Low</span>
            <strong><%= Math.round(weather.main.temp_min) %>°C</strong>
          </div>

          <div class="detail-item">
            <span>High</span>
            <strong><%= Math.round(weather.main.temp_max) %>°C</strong>
          </div>
        </div>
      </section>
    <% } %>

    <!--
      SEVEN-DAY FORECAST:
      The forecast array is created in index.js.
      EJS loops through each day's forecast and creates a card.
    -->
    <% if (forecast && forecast.length > 0) { %>
      <section class="forecast-section">
        <h2>7-Day Forecast</h2>
        <p class="section-description">A look at the weather over the next seven days.</p>

        <div class="forecast-grid">
          <% forecast.forEach(function(day) { %>
            <article class="forecast-card">

              <!-- Day of the week and calendar date -->
              <h3><%= day.day %></h3>
              <p class="forecast-date"><%= day.date %></p>

              <!-- Weather emoji and description from index.js -->
              <div class="forecast-icon" aria-hidden="true">
                <%= day.icon %>
              </div>

              <p class="forecast-description"><%= day.description %></p>

              <!-- Daily high and low temperatures -->
              <div class="forecast-temperatures">
                <strong><%= Math.round(day.maxTemp) %>°</strong>
                <span><%= Math.round(day.minTemp) %>°</span>
              </div>
            </article>
          <% }); %>
        </div>
      </section>
    <% } %>

    <!-- Welcome message shown before the first search -->
    <% if (!weather && !error) { %>
      <section class="welcome-message">
        <h2>Find out what's happening outside</h2>
        <p>Search for a city to see its current weather and seven-day forecast.</p>
      </section>
    <% } %>

    <!-- Footer at the bottom of the page -->
    <footer class="app-footer">
      <p>SkyCast Weather App</p>
      <p>Current conditions powered by OpenWeather. Forecast powered by Open-Meteo.</p>
    </footer>

  </main>
</body>
</html>
